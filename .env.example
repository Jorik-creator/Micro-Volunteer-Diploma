# Copy to .env and adjust. Every value can also be set as a real environment variable.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. Example for PostgreSQL:
# DATABASE_URL=postgres://microvolunteer:microvolunteer@localhost:5432/microvolunteer
DATABASE_URL=

DJANGO_SETTINGS_MODULE=config.settings.development

# Absolute links in emails
SITE_URL=http://localhost:8000

# Email: console backend locally; set BREVO_API_KEY in production (HTTPS API, SMTP is blocked on the host)
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=MicroVolunteer <noreply@example.com>

# Shared secret for POST /tasks/run/ (external cron). Empty disables the endpoint.
CRON_SECRET=

# One-click demo login buttons on the login page
DEMO_MODE=False
